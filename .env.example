# Copy to .env (git-ignored) and fill in the two required values. Never commit a real .env.

# Required. Left empty on purpose: the stack refuses to start until you set them.
# The Postgres password goes inside DATABASE_URL, so use only letters, digits, - and _
# (or percent-encode other characters).
PODCLATCH_TOKEN=
POSTGRES_PASSWORD=

# Optional; the values below are the defaults.
# PODCLATCH_PORT=8180
# PODCLATCH_BIND_ADDRESS=127.0.0.1
# PODCLATCH_POSTGRES_PORT=5442
# Grafana (traces and metrics), always on 127.0.0.1; there is no bind-address override on purpose.
# PODCLATCH_GRAFANA_PORT=3180
# REFRESH_INTERVAL_HOURS=3
# LOG_LEVEL=INFO
# POSTGRES_USER=podclatch
# POSTGRES_DB=podclatch
# Search calls this URL. Normal use leaves it alone (only the integration tests change it).
# ITUNES_SEARCH_URL=https://itunes.apple.com/search

# Optional telemetry (standard OpenTelemetry variables). With no endpoint the server exports
# nothing. docker-compose.yaml already sets both for `make up` (to the lgtm service), so leave
# these alone with Compose; they matter only when you run the server outside Compose.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=podclatch-server

# Optional: lets Grafana wake the GitHub Actions workflow when the alert fires (issue #113).
# Fine-grained token, this repository only, Contents read and write, 30-day expiry. Never commit it.
# Reaches only the lgtm service. Unset is fine: the alert still reaches the local receiver.
# GITHUB_DISPATCH_TOKEN=

# Optional: bearer token for the read-only telemetry gateway (issue #117). Generate it yourself, for
# example `openssl rand -hex 32`, and never commit it. Unset is fine: the gateway then refuses every request.
# TELEMETRY_GATEWAY_TOKEN=
# PODCLATCH_TELEMETRY_GATEWAY_PORT=8380
