<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext is permitted for every build: podcast audio is often plain http:// on arbitrary publisher
    hosts, and the OS cannot tell audio from the PodClatch Server. The bearer-token rule (HTTPS, except
    localhost, 127.0.0.1, and 10.0.2.2) is enforced in app code instead: ServerUrlValidator rejects such a
    server address, and the token guard interceptor (TokenGuard.kt) refuses to send the token over plain
    HTTP to any other host. Debug and release share this file and differ only through isDebuggable there.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!-- The token is guarded in app code (see above); audio needs plain HTTP to arbitrary hosts. -->
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
