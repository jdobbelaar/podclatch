# Copy to .env and edit. Placeholder values only; never commit a real .env.

# Database URL. Defaults to a local SQLite file. Postgres in Docker Compose and AWS.
DATABASE_URL=sqlite:///./podclatch.db

# The single access token clients must present. Required unless test mode is on.
PODCLATCH_TOKEN=change-me

# Hours between scheduled feed refreshes (positive number). Default 3.
REFRESH_INTERVAL_HOURS=3

# Logging level: DEBUG, INFO, WARNING, ERROR, or CRITICAL. Default INFO.
LOG_LEVEL=INFO

# Test mode lets the server start without PODCLATCH_TOKEN. Off by default; leave it off
# (or unset) everywhere except automated tests.
PODCLATCH_TEST_MODE=false
