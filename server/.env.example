# Copy to .env and edit. Placeholder values only; never commit a real .env.

# Database URL. Defaults to a SQLite file named podclatch.db in the working directory (server/).
# Postgres (Docker Compose, AWS) looks like the commented line below. Placeholder values only.
# The schema is created and upgraded automatically at startup.
DATABASE_URL=sqlite:///./podclatch.db
# DATABASE_URL=postgresql://podclatch:change-me@localhost:5432/podclatch

# Optional, tests only: a running Postgres to run the whole test suite against as well as SQLite.
# Each test gets its own throwaway schema. Leave it unset to skip the Postgres tests.
# PODCLATCH_TEST_DATABASE_URL=postgresql://podclatch:change-me@localhost:5432/podclatch_test

# The single access token clients must present. Required unless test mode is on.
PODCLATCH_TOKEN=change-me

# Hours between scheduled feed refreshes (positive number). Default 3.
REFRESH_INTERVAL_HOURS=3

# Logging level: DEBUG, INFO, WARNING, ERROR, or CRITICAL. Default INFO.
LOG_LEVEL=INFO

# Test mode lets the server start without PODCLATCH_TOKEN. Off by default; leave it off
# (or unset) everywhere except automated tests.
PODCLATCH_TEST_MODE=false
